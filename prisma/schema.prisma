generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InboxItem {
  id        Int          @id @default(autoincrement())
  text      String       // subject line
  tag       String       @default("general")
  body      String?      // notes, plain text
  meta      String?      // JSON: { dates?: [{label, date}], location?, links?: [] }
  source    String       @default("manual") // "manual" | "hermes"
  createdAt DateTime     @default(now())
  media     InboxMedia[]
}

model InboxMedia {
  id        Int       @id @default(autoincrement())
  itemId    Int
  item      InboxItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file      String    // uuid filename inside MEDIA_DIR
  mime      String
  createdAt DateTime  @default(now())
}

model WeeklyItem {
  id          Int       @id @default(autoincrement())
  weekKey     String
  label       String
  status      String    @default("pending")
  pos         Int       @default(0)
  completedAt DateTime? // set when status → done; item leaves the list 24 h later (stays in archive)
}

model Setting {
  key   String @id
  value String
}

// One thing that happened, from a source an agent can't fake: an NFC tap, a Fitness-app
// workout, a Forma session, a flag, a message from my phone (Nov 24th, 2026).
model HabitEvent {
  id        Int      @id @default(autoincrement())
  habit     String   // a key in habits.config.js
  day       String   // YYYY-MM-DD in my time zone, 04:00 cutoff (lib/habits.js dayOf)
  at        DateTime
  source    String   // "nfc" | "fitness" | "forma" | "htb" | "pwncollege" | "hermes"
  ref       String?  // the source's own id; with source it stops a resend counting twice
  note      String?
  createdAt DateTime @default(now())

  @@unique([source, ref])
  @@index([habit, day])
}
