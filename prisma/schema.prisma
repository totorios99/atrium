generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InboxItem {
  id        Int          @id @default(autoincrement())
  text      String       // subject line
  tag       String       @default("general")
  body      String?      // notes, plain text
  meta      String?      // JSON: { dates?: [{label, date}], location?, links?: [] }
  source    String       @default("manual") // "manual" | "hermes"
  createdAt DateTime     @default(now())
  media     InboxMedia[]
}

model InboxMedia {
  id        Int       @id @default(autoincrement())
  itemId    Int
  item      InboxItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file      String    // uuid filename inside MEDIA_DIR
  mime      String
  createdAt DateTime  @default(now())
}

model WeeklyItem {
  id      Int    @id @default(autoincrement())
  weekKey String
  label   String
  status  String @default("pending")
  pos     Int    @default(0)
}

model Setting {
  key   String @id
  value String
}

model HabitHistory {
  id       Int     @id @default(autoincrement())
  vaultId  String
  date     String
  habitKey String
  value    Boolean @default(false)

  @@unique([vaultId, date, habitKey])
}
